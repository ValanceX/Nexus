{
  "name": "@valancex/nexus",
  "version": "0.10.1",
  "description": "Valance application/runtime logic layer — orchestration, domain logic, commands, state, and capability resolution.",
  "type": "module",
  "license": "MIT",
  "author": "Jack Miller <jackmiller0899@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValanceX/Nexus.git"
  },
  "homepage": "https://github.com/ValanceX/Nexus#readme",
  "bugs": {
    "url": "https://github.com/ValanceX/Nexus/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@valancex/mesh-runtime": "^0.7.0",
    "effect": "^3.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@valancex/mesh-compiler": "^0.7.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
